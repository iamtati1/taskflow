# Copy to server/.env (git-ignored) and fill in. Never commit real values.

# Database: server/db/pool.js connects with DATABASE_URL.
#   Local:  postgresql://USER:PASSWORD@127.0.0.1:5432/taskflow
#   Render: set DATABASE_URL in the web service's Environment settings to the
#           Render Postgres connection string; it is not stored in the repo.
DATABASE_URL=

# Local-only alternative: leave DATABASE_URL empty and pg reads these instead
PGHOST='127.0.0.1'
PGPORT=5432
PGDATABASE='taskflow'
PGUSER=''
PGPASSWORD=''

# Replace with your own random string — used to sign session cookies.
# Required in production; generate one with: openssl rand -hex 32
SESSION_SECRET='your-random-secret-here'

# "production" turns on SSL for the database connection and secure cookies,
# and makes the server refuse to start without a real SESSION_SECRET
NODE_ENV=development

# Optional: port to listen on (defaults to 8080; Render sets it automatically)
# PORT=8080
